# =============================================================================
# Radio Showrunner — Docker Compose environment file
# =============================================================================
# Copy this file to .env.compose and fill in your values.
# Run with: docker compose --env-file .env.compose up -d
#
# Each station is independent. HOST_PORT is the port exposed on your server.
# Internal port (8080) is fixed in the container — only HOST_PORT changes.
# =============================================================================


# -----------------------------------------------------------------------------
# STATION 1
# -----------------------------------------------------------------------------

# Supabase
STATION1_SUPABASE_URL=https://your-project.supabase.co
STATION1_SERVICE_KEY=your-service-role-key
STATION1_BUCKET=show-audio

# Icecast source connection
STATION1_ICE_HOST=radio.example.com
STATION1_ICE_PORT=8025
STATION1_ICE_USER=source
STATION1_ICE_PASS=yourpassword
# Switch to default creds after this many 401s (0 = disabled)
STATION1_AUTH_401_FAILOVER=3

# Icecast admin kick — clears a stuck source before connecting
STATION1_ADMIN_KICK=false
STATION1_ADMIN_PROTO=http
STATION1_ADMIN_HOST=radio.example.com
STATION1_ADMIN_PORT=8025
STATION1_ADMIN_USER=admin
STATION1_ADMIN_PASS=yourpassword
STATION1_KICK_BEFORE_START=false
STATION1_KICK_ON_ATTEMPT=2

# Now Playing POST (optional — leave blank to disable)
STATION1_NOWPLAYING_URL=
STATION1_NOWPLAYING_KEY=

# Scheduling
STATION1_TZ=Europe/London
# Pre-fetch audio this many ms before show start (600000 = 10 min)
STATION1_PREFETCH_MS=0
STATION1_RESYNC_MS=300000
STATION1_EOF_BEHAVIOR=resume

# Port exposed on the host — pick any free port
STATION1_HOST_PORT=8080


# -----------------------------------------------------------------------------
# STATION 2
# -----------------------------------------------------------------------------

STATION2_SUPABASE_URL=https://your-project-2.supabase.co
STATION2_SERVICE_KEY=your-service-role-key-2
STATION2_BUCKET=show-audio

STATION2_ICE_HOST=radio2.example.com
STATION2_ICE_PORT=8025
STATION2_ICE_USER=source
STATION2_ICE_PASS=yourpassword
STATION2_AUTH_401_FAILOVER=3

STATION2_ADMIN_KICK=false
STATION2_ADMIN_PROTO=http
STATION2_ADMIN_HOST=radio2.example.com
STATION2_ADMIN_PORT=8025
STATION2_ADMIN_USER=admin
STATION2_ADMIN_PASS=yourpassword
STATION2_KICK_BEFORE_START=false
STATION2_KICK_ON_ATTEMPT=2

STATION2_NOWPLAYING_URL=
STATION2_NOWPLAYING_KEY=

STATION2_TZ=Europe/London
STATION2_PREFETCH_MS=0
STATION2_RESYNC_MS=300000
STATION2_EOF_BEHAVIOR=resume

# Must be different from STATION1_HOST_PORT
STATION2_HOST_PORT=8081


