# =============================================================================
# Radio Showrunner — Docker Compose environment file
# =============================================================================
# Copy this file to .env.compose and fill in your values.
# Run with: docker compose --env-file .env.compose up -d --build
#
# REQUIRED fields are marked [required]. Everything else has a working default.
# =============================================================================


# =============================================================================
# STATION 1
# =============================================================================

# --- Supabase [required] ---
STATION1_SUPABASE_URL=https://your-project.supabase.co
STATION1_SERVICE_KEY=your-service-role-key
STATION1_BUCKET=show-audio

# --- Icecast source connection [required] ---
STATION1_ICE_HOST=radio.example.com
STATION1_ICE_PORT=8025
STATION1_ICE_USER=source
STATION1_ICE_PASS=yourpassword
# Switch to above default creds after N consecutive 401s (0 = disabled)
STATION1_AUTH_401_FAILOVER=3

# --- Icecast admin kick (clears a stuck source before connecting) ---
STATION1_ADMIN_KICK=false
STATION1_ADMIN_PROTO=http
STATION1_ADMIN_HOST=radio.example.com
STATION1_ADMIN_PORT=8025
STATION1_ADMIN_USER=admin
STATION1_ADMIN_PASS=yourpassword
STATION1_KICK_BEFORE_START=false
# Kick on attempt N (0 = disabled, 2 = kick on the 2nd retry)
STATION1_KICK_ON_ATTEMPT=0

# --- Now Playing API (optional — leave blank to disable) ---
STATION1_NOWPLAYING_URL=
STATION1_NOWPLAYING_KEY=

# --- Timezone [required] ---
# IANA timezone name: Europe/London, America/New_York, Australia/Sydney, etc.
STATION1_TZ=Europe/London

# --- Scheduling ---
# Pre-fetch audio this many ms before show start (0 = disabled, 600000 = 10 min)
STATION1_PREFETCH_MS=0
# How often to rescan the DB for upcoming jobs (ms)
STATION1_RESYNC_MS=300000
# How long to wait after cancelling a competing job before starting (ms)
STATION1_PREEMPT_WAIT_MS=5000
STATION1_PREEMPT_POLL_MS=500

# --- Connection & retries ---
# Total window to keep retrying the initial Icecast connect (ms)
STATION1_RETRY_TOTAL_MS=180000
STATION1_RETRY_DELAY_MS=5000
# Consider ffmpeg "connected" once it has been alive this long (ms)
STATION1_CONNECT_GRACE_MS=7000
# Delay before reconnecting mid-show after a drop (ms)
STATION1_RECONNECT_DELAY_MS=2000

# --- Streaming ---
# What to do when the file ends before the slot ends: resume | loop | stop
STATION1_EOF_BEHAVIOR=resume
# Download to disk before playing (avoids Supabase signed URL expiry mid-show)
STATION1_LOCAL_COPY=true
# Supabase signed URL lifetime in seconds
STATION1_SIGNED_URL_TTL=3600
# File download retry window (ms) and delay between attempts
STATION1_DL_RETRY_TOTAL_MS=600000
STATION1_DL_RETRY_DELAY_MS=5000
# Safety cap on local file size (MB)
STATION1_MAX_FILE_MB=2048
STATION1_MIN_FILE_BYTES=65536
STATION1_HANDOVER_GAP_MS=2000
STATION1_FADE_OUT_MS=2000
STATION1_FORCE_KILL_AFTER_MS=1000

# --- Monitoring ---
# Check file duration with ffprobe before playing
STATION1_FFPROBE=true
# Warn if file is shorter than slot by more than N seconds
STATION1_DURATION_WARN_PAD=5
# Number of recent ffmpeg errors shown in /status
STATION1_LAST_ERROR_LIMIT=5

# --- Port [required] ---
# Port exposed on the Docker host — pick any free port
STATION1_HOST_PORT=8080


# =============================================================================
# STATION 2
# =============================================================================

# --- Supabase [required] ---
STATION2_SUPABASE_URL=https://your-project-2.supabase.co
STATION2_SERVICE_KEY=your-service-role-key-2
STATION2_BUCKET=show-audio

# --- Icecast source connection [required] ---
STATION2_ICE_HOST=radio2.example.com
STATION2_ICE_PORT=8025
STATION2_ICE_USER=source
STATION2_ICE_PASS=yourpassword
STATION2_AUTH_401_FAILOVER=3

# --- Icecast admin kick ---
STATION2_ADMIN_KICK=false
STATION2_ADMIN_PROTO=http
STATION2_ADMIN_HOST=radio2.example.com
STATION2_ADMIN_PORT=8025
STATION2_ADMIN_USER=admin
STATION2_ADMIN_PASS=yourpassword
STATION2_KICK_BEFORE_START=false
STATION2_KICK_ON_ATTEMPT=0

# --- Now Playing API ---
STATION2_NOWPLAYING_URL=
STATION2_NOWPLAYING_KEY=

# --- Timezone [required] ---
STATION2_TZ=Europe/London

# --- Scheduling ---
STATION2_PREFETCH_MS=0
STATION2_RESYNC_MS=300000
STATION2_PREEMPT_WAIT_MS=5000
STATION2_PREEMPT_POLL_MS=500

# --- Connection & retries ---
STATION2_RETRY_TOTAL_MS=180000
STATION2_RETRY_DELAY_MS=5000
STATION2_CONNECT_GRACE_MS=7000
STATION2_RECONNECT_DELAY_MS=2000

# --- Streaming ---
STATION2_EOF_BEHAVIOR=resume
STATION2_LOCAL_COPY=true
STATION2_SIGNED_URL_TTL=3600
STATION2_DL_RETRY_TOTAL_MS=600000
STATION2_DL_RETRY_DELAY_MS=5000
STATION2_MAX_FILE_MB=2048
STATION2_MIN_FILE_BYTES=65536
STATION2_HANDOVER_GAP_MS=2000
STATION2_FADE_OUT_MS=2000
STATION2_FORCE_KILL_AFTER_MS=1000

# --- Monitoring ---
STATION2_FFPROBE=true
STATION2_DURATION_WARN_PAD=5
STATION2_LAST_ERROR_LIMIT=5

# --- Port [required] ---
# Must be different from STATION1_HOST_PORT
STATION2_HOST_PORT=8081


